#!/bin/sh
# Pre-commit hook for intunewin-rs
# Runs cargo fmt and cargo clippy before each commit

set -e

echo "Running cargo fmt..."
cargo fmt -- --check
if [ $? -ne 0 ]; then
    echo "ERROR: Code is not formatted. Run 'cargo fmt' before committing."
    exit 1
fi

echo "Running cargo clippy..."
cargo clippy --all-targets --all-features -- -D warnings
if [ $? -ne 0 ]; then
    echo "ERROR: Clippy found issues. Fix them before committing."
    exit 1
fi

echo "Pre-commit checks passed!"
